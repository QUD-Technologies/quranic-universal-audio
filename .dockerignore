# Build context is the repo root (one level above inspector/).
# Docker reads .dockerignore from the build-context root, NOT from the
# directory containing the Dockerfile — so this MUST live here, not under
# inspector/.dockerignore (which docker silently ignores).
#
# Excluded paths come from inspector-data-storage.md §7.

# --- Sibling Spaces / repos not needed in the inspector image ---
# These are nested git repos that must never be baked into the image.
.local/
mfa_aligner/
reciter_requests/

# --- Runtime-shared packages ship at runtime. qua_shared/ + qua_jobs/ are
# root-level (not excluded here), COPYed into the image by the Dockerfile;
# qua_jobs/ also holds the HF-Job entrypoints stage_job_code uploads on launch.
# scripts/ holds only local operational CLIs — not needed in the image, except
# the talqeen-quran-data installer the quran-data-build stage runs.
scripts/
!scripts/devenv/install_quran_data.py

# --- Data: per-reciter data lives in the bucket (mounted at runtime),
# not baked into the image. Only phoneme_sub_costs.json is pulled in via the
# explicit COPY in the Dockerfile; the Quran data pack is fetched at the pin by
# the quran-data-build stage, never taken from a local checkout (nor are its fonts
# and the frontend's TS SDK tarball).
data/quran-core.qref
data/fonts/
inspector/frontend/.quran-data/
data/audio/
data/recitation_segments/
data/timestamps/
data/qul_downloads/
data/.cache/
data/reciters_index.json
data/riwayat.json
data/sources.json
data/styles.json
data/.audio_meta.json
data/.audio_durations.json
data/RECITERS.md
data/README.md
data/**/validation.log
data/**/beam_diff_report.txt
data/**/*.bak

# --- Repo metadata + docs. .github/config/ stays (job-side config_loader
# reads .github/config/repo.yml after stage_job_code uploads it).
.git/
.github/*
!.github/config
.claude/
.notion/
.vscode/
docs/
*.md
!inspector/CONTRIBUTING.md
# Render-templates the inspector image needs at runtime (release-body preview)
# + ship to the job. Re-include the dir AND the .md files (the `docs/` and
# `*.md` excludes above would otherwise drop them from the build context).
!docs/templates/
!docs/templates/release_body.md
!docs/templates/hf_dataset_card.md

# --- Inspector internals not needed at runtime ---
inspector/CLAUDE.md
inspector/tests/
# inspector/frontend/src/ is needed by the frontend-build stage; the runtime
# stage explicitly COPYs dist/ from that stage and not src/, so excluding it
# globally would only break the build.
inspector/frontend/node_modules/
inspector/frontend/.vite/
inspector/frontend/dist/
inspector/.cache/
inspector/requirements-dev.txt
inspector/docker-compose.yml
inspector/.dockerignore

# --- Python build artifacts ---
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info
.pytest_cache/
.mypy_cache/

# --- Local env / virtualenvs ---
.venv/
venv/
env/
.env
.env.*

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Backups / temp ---
*.bak
captures/
**/.cache/
