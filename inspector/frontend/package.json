{
  "name": "inspector-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "paraglide:compile": "npx --no-install @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --output-structure message-modules --emit-ts-declarations",
    "postinstall": "npm run paraglide:compile",
    "dev": "npm run paraglide:compile && vite",
    "build": "npm run paraglide:compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run paraglide:compile && tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js,svelte}\" --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.{ts,js,css,html,svelte}\"",
    "check": "npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@huggingface/space-header": "^1.0.4",
    "@quranic-phonemizer/cells": "github:QUD-Technologies/phonemizer-website#cells-v2.2.5",
    "chart.js": "^4.4.0",
    "chartjs-plugin-annotation": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@inlang/paraglide-js": "2.20.1",
    "@inlang/plugin-message-format": "4.4.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^4",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.0.0",
    "eslint_d": "^15.0.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-svelte": "^2.46.1",
    "happy-dom": "^20.9.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
